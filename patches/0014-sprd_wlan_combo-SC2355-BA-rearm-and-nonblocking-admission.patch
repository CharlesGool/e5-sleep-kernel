 static inline int sprd_hif_init(struct sprd_hif *hif)
 {
+	spin_lock_init(&hif->ba_lock);
+	memset(hif->ba_generation, 0, sizeof(hif->ba_generation));
+	memset(hif->ba_pending, 0, sizeof(hif->ba_pending));
