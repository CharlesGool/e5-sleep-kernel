From b04050eb2a3f60f0681c8a913e004d733fe8b43c Mon Sep 17 00:00:00 2001
From: charles <gzcheng0822@gmail.com>
Date: Sun, 1 Nov 2026 07:38:32 +0000
Subject: [PATCH] drm/sprd: enable ST7365P controller dithering on the E5 panel

The E5 ST7365P panel shows banding in dark gradients.  Set B9=02 after the panel
INIT sequence and, when the bootloader has already lit the panel, once at the
DSI handoff.  Adapted from e5-linux devices/e5/panel-dither.py (kanoqwq, 2026-10-27).
---
 .../sprd_disp/e5-panel-dither.h               | 74 +++++++++++++++++++
 drivers/unisoc_platform/sprd_disp/sprd_dsi.c  |  1 +
 .../sprd_disp/sprd_dsi_panel.c                |  4 +
 .../sprd_disp/sprd_dsi_panel.h                |  2 +
 4 files changed, 81 insertions(+)
 create mode 100644 drivers/unisoc_platform/sprd_disp/e5-panel-dither.h

diff --git a/drivers/unisoc_platform/sprd_disp/e5-panel-dither.h b/drivers/unisoc_platform/sprd_disp/e5-panel-dither.h
new file mode 100644
index 0000000..bdc1ccb
--- /dev/null
+++ b/drivers/unisoc_platform/sprd_disp/e5-panel-dither.h
@@ -0,0 +1,74 @@
+/* E5 ST7365P: RGB888 input, controller-side colour dithering. */
+static void e5_st7365p_dither(struct sprd_panel *panel)
+{
+	static const u8 commands[][2] = {
+		{ 0xf0, 0xc3 }, { 0xf0, 0x96 }, { 0xb9, 0x02 },
+		{ 0xf0, 0x3c }, { 0xf0, 0x69 },
+	};
+	u8 reg = 0xb9, value = 0;
+	ssize_t ret;
+	int i;
+	bool written = true;
+	bool verified = false;
+
+	if (!of_node_name_eq(panel->info.of_node, "lcd_st7365p_mipi_hdp"))
+		return;
+	panel->e5_dither_applied = false;
+
+	/* Called under panel->lock, after INIT and before enabling backlight.
+	 * Even a failed write must close the extended-command bank again.
+	 */
+	for (i = 0; i < ARRAY_SIZE(commands); i++) {
+		if (i < 3 && !written)
+			continue;
+		if (panel->info.use_dcs)
+			ret = mipi_dsi_dcs_write_buffer(panel->slave, commands[i], 2);
+		else
+			ret = mipi_dsi_generic_write(panel->slave, commands[i], 2);
+		if (ret < 0) {
+			DRM_WARN("E5 ST7365P dither command %d failed: %zd\n", i, ret);
+			written = false;
+		}
+		if (i == 2 && written) {
+			ret = mipi_dsi_set_maximum_return_packet_size(panel->slave, 1);
+			if (ret < 0) {
+				DRM_WARN("E5 ST7365P read size setup failed: %zd\n", ret);
+				continue;
+			}
+			if (panel->info.use_dcs)
+				ret = mipi_dsi_dcs_read(panel->slave, reg, &value, 1);
+			else
+				ret = mipi_dsi_generic_read(panel->slave, &reg, 1, &value, 1);
+			if (ret != 1 || value != 0x02)
+				DRM_WARN("E5 ST7365P B9 readback: ret=%zd value=%02x\n", ret, value);
+			else
+				verified = true;
+		}
+	}
+	panel->e5_dither_applied = written && verified;
+	if (panel->e5_dither_applied)
+		DRM_INFO("E5 ST7365P B9=02 verified\n");
+}
+
+/* Initial boot adopts an already running DSI host and bypasses panel_enable.
+ * Apply once there as well, under the same panel lock. The E5 stock host
+ * starts in video mode with LP commands disabled; restore its configured
+ * video command policy after this transaction.
+ */
+void sprd_panel_e5_dither_handoff(struct sprd_panel *panel)
+{
+	struct sprd_dsi *dsi;
+	struct mipi_dsi_host *host;
+
+	if (!of_node_name_eq(panel->info.of_node, "lcd_st7365p_mipi_hdp"))
+		return;
+	host = panel->slave->host;
+	dsi = host_to_dsi(host);
+	mutex_lock(&panel->lock);
+	if (!panel->e5_dither_applied) {
+		sprd_dsi_lp_cmd_enable(dsi, true);
+		e5_st7365p_dither(panel);
+		sprd_dsi_lp_cmd_enable(dsi, dsi->ctx.video_lp_cmd_en);
+	}
+	mutex_unlock(&panel->lock);
+}
diff --git a/drivers/unisoc_platform/sprd_disp/sprd_dsi.c b/drivers/unisoc_platform/sprd_disp/sprd_dsi.c
index 0111018..92f6a7f 100644
--- a/drivers/unisoc_platform/sprd_disp/sprd_dsi.c
+++ b/drivers/unisoc_platform/sprd_disp/sprd_dsi.c
@@ -146,6 +146,7 @@ static void sprd_dsi_encoder_enable(struct drm_encoder *encoder)
 
 	if (dsi->ctx.enabled) {
 		DRM_INFO("dsi is initialized\n");
+		sprd_panel_e5_dither_handoff(panel);
 		if (!strcmp(dpu->ctx.version, "dpu-r6p0")) {
 			if (!dpu->ctx.enabled) {
 				DRM_ERROR("dpu has no power, powered dpu\n");
diff --git a/drivers/unisoc_platform/sprd_disp/sprd_dsi_panel.c b/drivers/unisoc_platform/sprd_disp/sprd_dsi_panel.c
index f709678..bdf2735 100644
--- a/drivers/unisoc_platform/sprd_disp/sprd_dsi_panel.c
+++ b/drivers/unisoc_platform/sprd_disp/sprd_dsi_panel.c
@@ -343,6 +343,8 @@ static int sprd_panel_disable(struct drm_panel *p)
 	return 0;
 }
 
+#include "e5-panel-dither.h"
+
 static int sprd_panel_enable(struct drm_panel *p)
 {
 	struct sprd_panel *panel = to_sprd_panel(p);
@@ -354,6 +356,8 @@ static int sprd_panel_enable(struct drm_panel *p)
 			     panel->info.cmds[CMD_CODE_INIT],
 			     panel->info.cmds_len[CMD_CODE_INIT]);
 
+	e5_st7365p_dither(panel);
+
 	if (panel->backlight && !panel->sprd_bl_mipi_type) {
 		panel->backlight->props.power = FB_BLANK_UNBLANK;
 		panel->backlight->props.state &= ~BL_CORE_FBBLANK;
diff --git a/drivers/unisoc_platform/sprd_disp/sprd_dsi_panel.h b/drivers/unisoc_platform/sprd_disp/sprd_dsi_panel.h
index 715e186..f6cfd6b 100644
--- a/drivers/unisoc_platform/sprd_disp/sprd_dsi_panel.h
+++ b/drivers/unisoc_platform/sprd_disp/sprd_dsi_panel.h
@@ -139,6 +139,7 @@ struct sprd_panel {
 	struct mutex lock;
 	bool enabled;
 	bool is_esd_rst;
+	bool e5_dither_applied;
 };
 
 struct sprd_oled {
@@ -156,6 +157,7 @@ int sprd_panel_parse_lcddtb(struct device_node *lcd_node,
 void  sprd_panel_enter_doze(struct drm_panel *p);
 void  sprd_panel_exit_doze(struct drm_panel *p);
 int sprd_panel_send_vrefresh_cmd(struct sprd_panel *panel, int index);
+void sprd_panel_e5_dither_handoff(struct sprd_panel *panel);
 struct device_node *sprd_get_panel_node_by_name(void);
 
 #define to_sprd_panel(panel) \
-- 
2.34.1

