diff --git a/upstream/e5-mainline.config b/upstream/e5-mainline.config
index 222490f..132940b 100644
--- a/upstream/e5-mainline.config
+++ b/upstream/e5-mainline.config
@@ -114,6 +114,12 @@ CONFIG_MMC_SDHCI_SPRD=y
 # PM_SLEEP wakeup_source_register() is a stub that returns NULL, and the Type-C driver fails its probe)
 CONFIG_PM=y
 CONFIG_SUSPEND=y
+# CPU idle states: the vendor DTB has PSCI core and cluster power-down states (idle-states: core-sleep-lit,
+# core-sleep-mid, cluster-pd); without a cpuidle driver an idle core only runs WFI, never powered down
+CONFIG_CPU_IDLE=y
+CONFIG_CPU_IDLE_GOV_MENU=y
+CONFIG_CPU_IDLE_GOV_TEO=y
+CONFIG_ARM_PSCI_CPUIDLE=y
 # USB (device mode): the PMIC's Type-C controller is the cable detection (extcon) the controller follows
 CONFIG_USB_SUPPORT=y
 CONFIG_EXTCON=y
